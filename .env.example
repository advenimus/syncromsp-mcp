# === Local (stdio) mode: Syncro API credentials ===
# Used by stdio mode and by HTTP mode with MCP_AUTH=false.
# In HTTP sign-in mode SYNCRO_API_KEY is ignored: each user signs in with
# their own key on the login page.
SYNCRO_API_KEY=your-api-key-here
SYNCRO_SUBDOMAIN=your-subdomain-here

# === Security ===
# OAuth gates ALL HTTP-mode connections. Do NOT disable on a public deployment.
# If you understand the risk and run on a strictly isolated network, you can
# disable OAuth by setting BOTH:
#   MCP_AUTH=false
#   MCP_I_UNDERSTAND_INSECURE=true
# The server refuses to start with MCP_AUTH=false alone (foot-gun guard).

# === Transport (stdio or http) ===
MCP_TRANSPORT=stdio
MCP_PORT=8080

# === Tool Mode ===
# "flat" — all 170 tools registered at startup (default, works with all clients)
# "navigation" — lazy-loaded domains via syncro_navigate (lower tokens, needs client support)
# MCP_TOOL_MODE=flat

# === HTTP/Docker Deployment ===
# The public URL where this server is reachable (required for OAuth)
# Must be HTTPS for production (e.g., https://mcp.yourcompany.com)
# MCP_BASE_URL=https://mcp.yourcompany.com

# OAuth sign-in (enabled by default in HTTP mode)
# Set to "false" to disable (not recommended for public deployments)
# MCP_AUTH=true

# REQUIRED in HTTP sign-in mode: 32 random bytes that encrypt every token.
# Generate with:  openssl rand -hex 32
# Keep it secret and stable. Changing it signs everyone out.
MCP_TOKEN_ENCRYPTION_KEY=
# Only while rotating keys: the old value, used to read existing tokens.
# MCP_TOKEN_ENCRYPTION_KEY_PREVIOUS=

# REQUIRED in HTTP sign-in mode: which Syncro accounts may sign in. Set ONE:
#   SYNCRO_SUBDOMAIN (above)        lock sign-in to that one subdomain
#   MCP_ALLOWED_SUBDOMAINS=acme,beta
#   MCP_ALLOW_ANY_SUBDOMAIN=true

# Only these client return addresses may register (recommended).
# An entry without a port, like http://localhost, allows any port.
# MCP_ALLOWED_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback,https://claude.com/api/mcp/auth_callback,http://localhost,http://127.0.0.1

# Extra host names the server answers to besides the MCP_BASE_URL host.
# Requests for any other host are refused (blocks DNS rebinding).
# MCP_ALLOWED_HOSTS=

# === HTTP limits ===
# Close sessions idle this many minutes (default 60).
# MCP_SESSION_IDLE_MINUTES=60
# Most open sessions one signed-in user may hold (default 25).
# MCP_MAX_SESSIONS_PER_USER=25
# Outbound Syncro calls per minute across all tenants (default 180).
# MCP_SERVER_RATE_LIMIT_PER_MINUTE=180
